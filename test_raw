public (Mat H, AlignmentResult result) GetAlignmentMatrix(Mat capturedImage)
{
    var matches = FindOrbMatches(capturedImage);
    if (matches.Count < 20) return (null, new AlignmentResult { Success = false, FailureReason = "Not enough matches" });

    Point2f[] masterPts = matches.Select(x => x.Item1).ToArray();
    Point2f[] capturedPts = matches.Select(x => x.Item2).ToArray();

    using var srcMat = InputArray.Create(capturedPts);
    using var dstMat = InputArray.Create(masterPts);
    using Mat inlierMask = new Mat();

    // Keep Homography as you requested
    Mat H = Cv2.FindHomography(srcMat, dstMat, HomographyMethods.Ransac, 3.0, inlierMask);
    if (H == null || H.Empty()) return (null, new AlignmentResult { Success = false, FailureReason = "Homography failed" });

    int inliers = Cv2.CountNonZero(inlierMask);
    if (inliers < 30) return (null, new AlignmentResult { Success = false, FailureReason = $"Only {inliers} inliers" });

    return (H, new AlignmentResult { Success = true, InlierCount = inliers });
}




