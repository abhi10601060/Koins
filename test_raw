public List<ZoneResult> DetectZonesOnRawImage(Mat rawCapturedImage, Mat H_inv, InspectionProfile profile)
{
    var results = new List<ZoneResult>();

    // Preprocess the raw captured image once (CLAHE + Blur)
    using Mat preprocessed = Preprocessor.Preprocess(rawCapturedImage, profile.Preprocessing);

    foreach (var zone in profile.Zones)
    {
        // 1. Get the 4 corners of the zone from the Master profile [x, y, w, h]
        Point2f[] masterBoxCorners = new Point2f[]
        {
            new Point2f(zone.Bbox[0], zone.Bbox[1]),                           // Top-Left
            new Point2f(zone.Bbox[0] + zone.Bbox[2], zone.Bbox[1]),          // Top-Right
            new Point2f(zone.Bbox[0] + zone.Bbox[2], zone.Bbox[1] + zone.Bbox[3]), // Bottom-Right
            new Point2f(zone.Bbox[0], zone.Bbox[1] + zone.Bbox[3])           // Bottom-Left
        };

        // 2. Project these corners onto the captured image using Inverse Homography!
        Point2f[] capturedBoxCorners = Cv2.PerspectiveTransform(masterBoxCorners, H_inv);

        // 3. Find the bounding rect of the projected corners on the captured image
        Rect projectedBbox = Cv2.BoundingRect(capturedBoxCorners);

        // Safety clamp
        projectedBbox = ClampRect(projectedBbox, preprocessed.Size());

        // 4. Crop cleanly from the raw preprocessed image (Zero interpolation blur!)
        using Mat crop = new Mat(preprocessed, projectedBbox);
        using Mat edges = new Mat();

        Cv2.Canny(crop, edges, profile.Preprocessing.CannyLow, profile.Preprocessing.CannyHigh);

        int totalPixels = projectedBbox.Width * projectedBbox.Height;
        int edgePixels = Cv2.CountNonZero(edges);
        double edgeDensity = totalPixels > 0 ? (double)edgePixels / totalPixels : 0.0;

        double ratio = zone.Threshold > 0 ? edgeDensity / zone.Threshold : 0.0;

        // Apply Uncertain Band logic...
        ZoneDecision decision = EvaluateDecision(ratio, profile.UncertainBand);

        results.Add(new ZoneResult
        {
            ZoneId = zone.Id,
            Label = zone.Label,
            EdgeDensity = Math.Round(edgeDensity, 6),
            Threshold = zone.Threshold,
            Ratio = Math.Round(ratio, 4),
            Decision = decision
        });
    }

    return results;
}
