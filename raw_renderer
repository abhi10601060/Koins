public Mat RenderResults(Mat capturedImage, List<ZoneResult> zoneResults, InspectionProfile profile)
{
    Mat rendered = capturedImage.Clone();

    foreach (var result in zoneResults)
    {
        // Pick color based on decision (Green = Present, Red = Missing, Orange = Uncertain)
        Scalar color = result.Decision switch
        {
            ZoneDecision.Present => new Scalar(0, 255, 0),     // Green
            ZoneDecision.Missing => new Scalar(0, 0, 255),     // Red
            ZoneDecision.Uncertain => new Scalar(0, 165, 255), // Orange
            _ => new Scalar(255, 255, 255)
        };

        // =====================================================================
        // FIX: USE THE DYNAMIC PROJECTED BOX INSTEAD OF STATIC CONFIG `zone.Bbox`
        // =====================================================================
        Rect box = result.ProjectedBbox;

        // Draw bounding box on the captured image
        Cv2.Rectangle(rendered, box, color, 2);

        // Draw label text above the box
        string text = $"{result.Label} [{result.Decision}]";
        Cv2.PutText(
            rendered, 
            text, 
            new Point(box.X, Math.Max(15, box.Y - 10)), 
            HersheyFonts.HersheySimplex, 
            0.5, 
            color, 
            1);
    }

    return rendered;
}
